rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    function isRider() {
      return isAuthenticated() && getUserRole() == 'RIDER';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // User Private Saved Addresses (Customer isolated)
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Products (Public read for active customers, Admin write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Customers read their own; Riders read their assigned orders; Admins read all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.assignedRiderId == request.auth.uid ||
        isAdmin()
      );

      // Order creation: Authenticated customer creating order with their own userId
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PLACED';

      // Status updates: Admins can update any; Riders can only update their assigned orders
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isRider() && resource.data.assignedRiderId == request.auth.uid) ||
        (isOwner(resource.data.userId) && resource.data.status in ['PLACED', 'ACCEPTED'] && request.resource.data.status == 'CANCELLED')
      );

      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Store Settings (Public read, Admin write)
    match /storeSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons (Public read for active codes, Admin write)
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs (Admin only)
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
